# Copy this file to .env.local and fill in your real credentials.
# .env.local is git-ignored -- never commit real API keys or passwords.

HONEYCOMB_API_KEY=your-honeycomb-api-key-here

# Only needed if you're on Honeycomb Classic (uncomment and set):
# HONEYCOMB_DATASET=rocky-mountain-ruby-demo

OTEL_SERVICE_NAME=rocky-mountain-ruby-demo

# DBOS Conductor (optional -- see README's "DBOS Conductor" section):
DBOS_CONDUCTOR_LICENSE_KEY=your-dbos-conductor-license-key-here
# DBOS_CONDUCTOR_KEY=your-dbos-conductor-app-api-key-here
# DBOS_CONDUCTOR_URL=ws://localhost:8090/
